@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page @(IsActionPanelExpanded ? "action-panel-expanded" : "action-panel-collapsed")">
    <div class="sidebar">
        <button type="button"
                class="action-panel-toggle"
                aria-label="@(IsActionPanelExpanded ? "Collapse action panel" : "Expand action panel")"
                aria-expanded="@IsActionPanelExpanded.ToString().ToLowerInvariant()"
                aria-controls="action-panel-navigation"
                @onclick="ToggleActionPanel">
            <i class="bi @(IsActionPanelExpanded ? "bi-chevron-bar-left" : "bi-chevron-bar-right")" aria-hidden="true"></i>
        </button>
        <NavMenu IsExpanded="IsActionPanelExpanded" NavigationRegionId="action-panel-navigation" />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">
                        <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                    </span>
                    <a href="/profile" class="me-3">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                    <a href="/notifications" class="me-3">
                        <i class="bi bi-bell"></i> Notifications
                    </a>
                    <a href="/logout" class="ms-auto">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="ms-auto">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool IsActionPanelExpanded { get; set; } = true;
    private string CurrentRoutePath { get; set; } = "/";

    protected override void OnInitialized()
    {
        CurrentRoutePath = NormalizeRoutePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void ToggleActionPanel()
    {
        IsActionPanelExpanded = !IsActionPanelExpanded;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var nextRoutePath = NormalizeRoutePath(args.Location);
        if (nextRoutePath == CurrentRoutePath)
        {
            return;
        }

        CurrentRoutePath = nextRoutePath;
        if (!IsActionPanelExpanded)
        {
            IsActionPanelExpanded = true;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string NormalizeRoutePath(string location)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(location);
        var suffixIndex = relativePath.IndexOfAny(['?', '#']);
        if (suffixIndex >= 0)
        {
            relativePath = relativePath[..suffixIndex];
        }

        relativePath = relativePath.Trim('/');
        return relativePath.Length == 0 ? "/" : $"/{relativePath}";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
