@page "/documents/reports"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Administrator")]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Document Reports - ContosoDashboard</PageTitle>

<div class="container-fluid document-reports-page">
    <h1>Document Activity Report</h1>
    <p class="text-muted">Administrator view of document usage across the training environment.</p>

    @if (loading)
    {
        <p><em>Loading...</em></p>
    }
    else if (report == null)
    {
        <div class="alert alert-warning">You are not authorized to view this report.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h6 class="text-muted">Total Documents</h6>
                        <h3>@report.TotalDocuments</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card summary-card">
                    <div class="card-body">
                        <h6 class="text-muted">Active Uploaders</h6>
                        <h3>@report.TotalActiveUploaders</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Documents by Category</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var entry in report.DocumentsByCategory)
                        {
                            <li class="list-group-item d-flex justify-content-between"><span>@entry.Key</span><span>@entry.Value</span></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Activity by Type (Access Patterns)</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var entry in report.ActivityCountsByAction)
                        {
                            <li class="list-group-item d-flex justify-content-between"><span>@entry.Key</span><span>@entry.Value</span></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Recent Activity</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Document</th><th>Action</th><th>Actor</th><th>Occurred</th></tr></thead>
                    <tbody>
                        @foreach (var activity in report.RecentActivity)
                        {
                            <tr>
                                <td>@activity.Document.Title</td>
                                <td>@activity.Action</td>
                                <td>@activity.ActorUser.DisplayName</td>
                                <td>@activity.OccurredDate.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private DocumentAuditReport? report;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
            report = await DocumentService.GetAuditReportAsync(userId);
        loading = false;
    }
}
