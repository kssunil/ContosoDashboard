@page "/documents"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid documents-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Documents</h1>
            <p class="text-muted mb-0">Your uploaded personal and project documents.</p>
        </div>
        <a href="/documents/upload" class="btn btn-primary"><i class="bi bi-upload"></i> Upload Documents</a>
    </div>

    @if (documents == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!documents.Any())
    {
        <div class="alert alert-info">No documents are available yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Title</th><th>Category</th><th>Project</th><th>Uploaded</th><th>Size</th><th>Uploaded By</th></tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td><strong>@document.Title</strong><br /><small class="text-muted">@document.OriginalFileName</small></td>
                            <td><span class="badge bg-secondary">@document.Category</span></td>
                            <td>@(document.Project?.Name ?? "Personal")</td>
                            <td>@document.UploadedDate.ToString("MMM dd, yyyy")</td>
                            <td>@FormatSize(document.FileSize)</td>
                            <td>@document.Uploader.DisplayName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Document>? documents;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
            documents = await DocumentService.GetAccessibleDocumentsAsync(userId);
        else
            documents = new List<Document>();
    }

    private static string FormatSize(long bytes)
    {
        return bytes switch
        {
            >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.##} MB",
            >= 1024 => $"{bytes / 1024d:0.##} KB",
            _ => $"{bytes} B"
        };
    }
}
